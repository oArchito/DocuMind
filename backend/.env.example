# ── DocuMind Backend Configuration ──
# Copy this file to .env and fill in your values

# Your Google Gemini API key (get one free at https://aistudio.google.com)
GEMINI_API_KEY=your-api-key-here

# Model names (change these if newer models become available)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# CORS origins (comma-separated). Use * for development.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Embedding dimensions (gemini-embedding-001 outputs 768-dim vectors)
EMBEDDING_DIM=768
